NODE_ENV=development
PORT=3000

# Local: mongodb://127.0.0.1:27017/project_x39
# Production: mongodb+srv://<username>:<password>@<cluster>/<db>
MONGODB_URI=

# 2 secret keys khac nhau, moi key toi thieu 32 ky tu
JWT_SECRET_ACCESS=
JWT_SECRET_REFRESH=

# CORS origins, cach nhau boi dau phay
# Local: http://localhost:5173,http://localhost:8080
# Production (Vercel): https://your-frontend.vercel.app
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Cloudinary
CLOUD_NAME=
CLOUD_API_KEY=
CLOUD_API_SECRET=